# Environment Configuration for Practo Healthcare Support Agent
# Default is fully deterministic MOCK_LLM mode (requires zero API keys, 0 external calls)
MOCK_LLM=true

# Embedding Model Configuration (Local SentenceTransformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# MCP Server Configuration
MCP_HOST=127.0.0.1
MCP_PORT=8000
